# Server Port
PORT=5000

# Database Settings (MongoDB connection URI)
# - For local docker-compose development: mongodb://mongodb:27017/autoshorts
# - For local host development: mongodb://localhost:27017/autoshorts
# - For production / MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/autoshorts
MONGO_URI=mongodb://mongodb:27017/autoshorts

# Environment Mode (development | production)
NODE_ENV=development

# AI / LLM Configuration
# Primary Provider options: mistral, groq, openrouter, ollama, openai, claude, gemini, deepseek
LLM_PROVIDER=mistral
LLM_MODEL=mistral-large-latest

# Comma-separated fallback chain to try if the primary provider fails or rate-limits
LLM_FALLBACK_PROVIDERS=groq,openrouter,ollama,deepseek,openai,gemini,claude

# Default number of clips to generate from each long video
DEFAULT_CLIP_COUNT=5

# AI Provider API Keys (Configure only the ones you use)
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Local Ollama Configuration
# Inside Docker container, use http://host.docker.internal:11434 to connect to host Ollama
OLLAMA_HOST=http://host.docker.internal:11434

# Transcription Services
# Options for transcriptionMode: local (OpenAI Whisper) | deepgram
DEEPGRAM_API_KEY=

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Google OAuth Credentials & Redirect URI
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Drive Central Service Account (Optional for centralized storage)
GDRIVE_SERVICE_ACCOUNT_KEY=
GDRIVE_CENTRAL_FOLDER_ID=

# SMTP / Mail Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDING_USER="AutoShorts <noreply@autoshorts.app>"
SEND_MAIL=false
